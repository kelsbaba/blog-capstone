<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Blog</title>

    <link rel="stylesheet" href="/styles/main.css">
</head>

<body>

    <header class="navbar">

        <div class="logo">
            📝 My Blog
        </div>

        <nav>

            <a href="/">Home</a>

            <a href="/create">Create Post</a>

            <% if (currentUser) { %>

                <span class="welcome-message">
                    Welcome, <%= currentUser.username %> 👋
                </span>

                <a href="/profile/<%= currentUser.id %>">
                    My Profile
                </a>

                <form
                    action="/logout"
                    method="POST"
                    class="logout-form"
                >
                    <button type="submit">
                        Logout
                    </button>
                </form>

            <% } else { %>

                <a href="/login">Login</a>

                <a href="/register">Register</a>

            <% } %>

            <form
                action="/search"
                method="GET"
                class="search-form"
            >
                <input
                    type="text"
                    name="q"
                    placeholder="Search posts..."
                    required
                >

                <button type="submit">
                    Search
                </button>
            </form>

        </nav>

    </header>

    <main class="container">