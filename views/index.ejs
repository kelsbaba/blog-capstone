<%- include("partials/header.ejs") %>

<section class="hero">

    <h1>Welcome to My Blog 📝</h1>

    <p>
        Discover stories, ideas, and inspiration.
    </p>

    <a href="/create" class="btn">
        Create Your First Post
    </a>

</section>

<nav class="category-nav">

    <a href="/" class="<%= !selectedCategory ? 'active' : '' %>">
        All Posts
    </a>

    <% categories.forEach(category => { %>
        <a
            href="/category/<%= category.id %>"
            class="<%= selectedCategory && selectedCategory.id === category.id ? 'active' : '' %>"
        >
            <%= category.name %>
        </a>
    <% }) %>

</nav>

<section class="posts-section">

    <% if (searchTerm) { %>
    <h2>Search Results for "<%= searchTerm %>"</h2>
<% } else { %>
    <h2>Latest Blog Posts</h2>
<% } %>
   <% if (posts.length === 0) { %>

    <% if (searchTerm) { %>
        <p>No posts found for "<%= searchTerm %>".</p>
    <% } else { %>
        <p>No posts yet. Create your first post!</p>
    <% } %>

<% } %>
    <div class="posts-grid">

        <% posts.forEach(post => { %>

            <article class="post-card">

                <h3>
                    <%= post.title %>
                </h3>

                <p class="post-meta">
                    By <%= post.author %> | <%= post.date %>
                </p>

                <p class="post-category">
    Category: <strong><%= post.category_name || "Uncategorized" %></strong>
</p>

                <p>
                    <%= post.content.substring(0, 150) %>
                    <% if (post.content.length > 150) { %>
                        ...
                    <% } %>
                </p>

                <a href="/post/<%= post.id %>" class="read-more">
                    Read More →
                </a>

            </article>

        <% }) %>

    </div>

</section>

<%- include("partials/footer.ejs") %>